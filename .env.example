# Copy to .env and fill in. Never commit .env.

OBP_BASE_URL=https://apisandbox.openbankproject.com
OBP_API_VERSION=v5.0.0
OBP_CONSUMER_KEY=your-consumer-key
OBP_CONSUMER_SECRET=your-consumer-secret

# Bank the sandbox customers belong to (check in the API Explorer)
OBP_BANK_ID=gh.29.uk

# Customer logins from the OBP sandbox wiki (Customer logins section)
CUSTOMER_A_USERNAME=robert.uk.29@example.com
CUSTOMER_A_PASSWORD=
CUSTOMER_B_USERNAME=susan.uk.29@example.com
CUSTOMER_B_PASSWORD=

# Largest single transfer the scripts make; bigger ones need a second approver in OBP
OBP_MAX_TRANSFER=800

# ---- The model: self-hosted vLLM (what this copy is for) ----
# The served model's Hugging Face id, after "vllm:".
MODEL=vllm:openai/gpt-oss-20b
# Where vLLM answers. From your PC: the SSH tunnel to the GPU machine (deploy/phase0/README.md).
# Docker on the GPU machine and Kubernetes set their own address, so this line is only for your PC.
VLLM_BASE_URL=http://127.0.0.1:8001/v1
# VLLM_API_KEY=                           # only if vLLM was started with --api-key
# VLLM_MAX_TOKENS=1024                    # longest answer per call
# VLLM_CACHE_SALT=per-customer            # off = customers share cached prompt blocks (not for real data)
# VLLM_SESSION_HEADER=x-session-id        # the router keeps a conversation on one GPU by this header
# VLLM_TEMPERATURE=0.3                    # default: the model's own (1.0 for gpt-oss); lower = steadier tool calls
# VLLM_TOP_P=                             # default: the model's own
# VLLM_REASONING_EFFORT=medium            # gpt-oss: low, medium or high (slower, often more reliable)
# MODEL_OUTPUT_RETRIES=2                  # broken model replies (tool markup as text, repeating, empty) asked again
# VLLM_SEND_REASONING=on                  # send gpt-oss's thinking back between tool calls of a turn (off = don't)

# Phase 0 (one GPU machine, deploy/phase0/compose.vllm.yml) reads these too:
VLLM_MODEL=openai/gpt-oss-20b             # keep it the same as MODEL above
# VLLM_TOOL_PARSER=openai                 # tool-call parser for VLLM_MODEL (vLLM docs, "Tool Calling")
# VLLM_TAG=v0.32.0                        # vLLM image; pin one release
# VLLM_PREFIX_CACHING_FLAG=--no-enable-prefix-caching   # only for the cache-off run (E2)
# VLLM_KV_CACHE_DTYPE=fp8                 # E5; default auto
# VLLM_MAX_NUM_SEQS=128                   # E4
# VLLM_MAX_NUM_BATCHED_TOKENS=8192        # E4
# VLLM_MAX_MODEL_LEN=16384
# HF_TOKEN=                               # only for gated models on Hugging Face

# Self-hosted tokens have no list price. After the benchmark, set one so cost reports work:
# GPU $ per hour / tokens per hour at your tested load, in $ per million tokens, e.g.
# MODEL_PRICES_JSON={"gpt-oss-20b": {"input": 0.05, "output": 0.20}}

# ---- Other models (the original project's options still work) ----
# Amazon Bedrock from Ireland: Claude Haiku 5.5 via the EU inference profile.
# MODEL=bedrock_converse:eu.anthropic.claude-haiku-5-5
AWS_REGION=eu-west-1
# Alternatives on Bedrock:
# MODEL=bedrock_converse:eu.anthropic.claude-sonnet-5-5   (stronger, ~20x the price; check the ID in the console)
# MODEL=bedrock_converse:qwen.qwen3-32b-v1:0              (open model, in-region in eu-west-1)
# Credentials: uncomment and paste a Bedrock API key, OR leave commented and run "aws configure"
# AWS_BEARER_TOKEN_BEDROCK=

# Self-hosted Ollama on AWS (model must support tools)
# MODEL=ollama:qwen3:14b
# OLLAMA_BASE_URL=http://localhost:11434   # via SSH tunnel; or the instance's private IP in your VPC
# OLLAMA_NUM_CTX=16384

# Anthropic API directly (same Claude models, no AWS needed)
# MODEL=anthropic:claude-haiku-5-5
# ANTHROPIC_API_KEY=sk-ant-api...          # console.anthropic.com > API Keys; no quotes or spaces

# LangSmith tracing (smith.langchain.com -> Settings -> API keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=banking-agent-vllm      # its own project, so traces never mix with the Claude version

# ---- Phase 2 multi-agent (defaults shown; only change if you move the servers) ----
# MCP_ACCOUNTS_URL=http://127.0.0.1:8101/mcp
# MCP_TRANSACTIONS_URL=http://127.0.0.1:8102/mcp
# MCP_SERVICE_URL=http://127.0.0.1:8103/mcp
# MCP_CHARTS_URL=http://127.0.0.1:8105/mcp
# SESSION_DB=sessions.db                  # conversations + pending confirmations (SQLite)
# OBP_FAKE=1                              # use the built-in fake bank instead of OBP (demo/offline)

# ---- Security codes (one-time passcodes) ----
# Address changes always need a code; transfers need one from this amount up (off = never)
OTP_TRANSFER_THRESHOLD=500
# The demo customers' @example.com emails can't receive mail, so codes go to your own inbox
OTP_EMAIL_TO=
# console = print codes in the MCP server window (no setup); smtp = really email them
EMAIL_BACKEND=console
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it below (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# EMAIL_FROM=                             # defaults to SMTP_USER
# VERIFY_URL=http://127.0.0.1:8104        # security code service, started by mcp_servers.run
# OTP_DB=verification.db                  # pending and used codes (hashed, never the code itself)

# ---- Phase 3: guardrails, costs, evals ----
# Amazon Bedrock guardrail (optional; without it only the built-in rules run).
# Create it with:  python -m scripts.setup_guardrail --test   (then paste the lines it prints)
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=1
# GUARDRAIL_REGION=eu-west-1
# GUARDRAIL_MODE=shadow                   # shadow = log what it would block; enforce = block
# GUARDRAIL_ON_ERROR=open                 # open = carry on if Bedrock is down; closed = refuse
# LANGSMITH_HIDE_CONTENT=false            # true = send timings only, no message text, to LangSmith
# TELEMETRY_DB=telemetry.db               # cost ledger; "off" to disable
# COST_ALERT_DAILY_USD=1.00               # scripts.cost_report warns above this
# EVAL_JUDGE_MODEL=anthropic:claude-sonnet-5-5
# EVAL_MIN_PASS_RATE=0.90
# EVAL_MAX_AVG_COST_USD=0.01
# EVAL_MAX_P95_SECONDS=45

# ---- Phase 4: web chat (python -m api) ----
# AUTH_MODE=dev                           # dev = pick a demo customer; cognito = the bank's sign-in (AWS)
# API_HOST=127.0.0.1
# PORT=8000
# COOKIE_SECURE=0                         # 1 behind HTTPS (set automatically on AWS)
# API_RATE_LIMIT_PER_MIN=30               # requests per signed-in session
# TURN_TIMEOUT_SECONDS=180                # an answer taking longer is stopped

# ---- Phase 4, step 2: Postgres and Docker ----
# Set to keep every record (conversations, codes, service requests, costs) in Postgres instead of
# SQLite files. Docker sets it for its own containers; this line is for Python running on your PC
# against  docker compose up -d db
# DATABASE_URL=postgresql://bank:bank-local-only@localhost:5432/bank
# POSTGRES_PASSWORD=bank-local-only        # password docker compose gives the local database
# POSTGRES_PORT=5432                       # change if another Postgres already uses 5432 (and in DATABASE_URL)
# SERVICE_REQUESTS_DB=service_requests.db  # service requests (SQLite, without DATABASE_URL)
# MCP_HOST=127.0.0.1                       # where the bank servers listen (Docker uses 0.0.0.0)

# ---- Deployment ----
# This copy runs on one GPU machine (deploy/phase0) or on Amazon EKS (deploy/k8s), not on the
# original's Fargate set-up. AWS_REGION above is where it goes (eu-west-1 = Ireland).

# ---- Phase 4, step 4a: visitors (each gets a pretend bank of their own) ----
# Signs visitors' bank tokens. Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=
# GUEST_TTL_HOURS=24                      # a visitor's demo bank is deleted after this
# GUEST_DAILY_MESSAGES=30                 # messages per visitor per 24 hours
# GUEST_SIGNUPS_PER_IP_HOUR=5             # new demo banks per internet address per hour
# DAILY_SPEND_CAP_USD=2.00                # model spend by all visitors together per day (UTC)
# CLIENT_IP_HEADER=                       # behind a proxy: X-Forwarded-For (load balancer) or
#                                         # CloudFront-Viewer-Address (CloudFront). AWS sets it.
# GUEST_DB=guest_banks.db                 # visitors' banks (SQLite, without DATABASE_URL)
# WEB_DB=web.db                           # sign-ins, answers in progress, waiting slips (SQLite)

# ---- Phase 4, step 4b: real sign-in ----
# public = "Continue with Google" or an emailed sign-in code; dev = the simple form (your PC only)
# AUTH_MODE=public
# Where people open the app; Google sends them back to PUBLIC_URL/api/auth/google/callback
# PUBLIC_URL=http://127.0.0.1:8000
# From Google Cloud Console > Google Auth Platform > Clients (see README, section 12)
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# Your own address(es): signing in with one of these makes you the owner (Robert and Anil)
# OWNER_EMAILS=you@gmail.com
# Sign-in emails use the same EMAIL_BACKEND / SMTP_* settings as security codes. Limits:
# SIGNIN_CODES_PER_EMAIL=3                # per address per 15 minutes
# SIGNIN_CODES_PER_IP_HOUR=10             # per internet address per hour
# SIGNIN_EMAILS_PER_DAY=300               # in total (Gmail sends at most 500 a day)

# ---- Phase 4, step 5: the app on AWS ----
# OPEN_HOURS=09:00-17:00                  # Irish time, every day; "always" = never closed
# OPEN_TIME_ZONE=Europe/Dublin
# OPEN_TO_PUBLIC=0                        # 0 = invite-only: OWNER_EMAILS and INVITED_EMAILS (AWS default until step 6)
# INVITED_EMAILS=friend@gmail.com         # comma-separated
# CONTACT_EMAIL=                          # shown on the privacy notice; default: the first OWNER_EMAILS address
# APP_MAX_COPIES=3                        # copies of the app when busy
# ORIGIN_SECRET is made for you by  python -m infra.app_secrets push

